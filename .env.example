# Runtime configuration for DAGs — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real filesystem paths or secrets.
#
# Resolution order in the DAGs: DAG Param > .env / process env > Airflow Variable.

# Optional: override the default Google Drive root folder IDs.
# The institutional capture DAG already has production defaults.
# STAFF_DRIVE_ROOT_FOLDER_ID=your_staff_drive_root_folder_id_here
# CIARP_DRIVE_ROOT_FOLDER_ID=your_ciarp_drive_root_folder_id_here

# Local host path used by Docker Compose to mount the Google Drive token pickle.
# This value is consumed by deployment/compose configuration, not by the DAG code.
GDRIVE_TOKEN_PICKLE_PATH=/absolute/local/path/to/google_token.pickle

# The Airflow Mongo connection `mongodb_default` should use this database/schema.
MONGO_DB_NAME=institutional_data

# Email notifications on DAG completion (success + failure).
# Leave ALERT_EMAIL_TO empty to disable emails entirely.
ALERT_EMAIL_TO=you@example.com
# Sender domain we control (colav.co) so SPF/DKIM can authorize direct delivery.
# ALERT_EMAIL_FROM=airflow@colav.co
